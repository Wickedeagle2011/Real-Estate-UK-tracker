def analyze_opportunities(
    session: requests.Session,
    zip_code: str,
    max_listings: int,
    max_avm_requests: int
) -> List[Dict[str, Any]]:
    print(
        "\n[2/5] Downloading active single-family listings..."
    )

    listings = fetch_sale_listings(
        session,
        zip_code,
        max_listings
    )

    print(
        f"[+] Retrieved {len(listings)} active listings."
    )

    if not listings:
        return []

    avm_cache = {}
    rent_cache = {}
    property_cache = {}

    opportunities = []

    print(
        "\n[3/5] Running property valuation analysis..."
    )

    total = min(
        len(listings),
        max_avm_requests
    )

    for index, listing in enumerate(
        listings[:total],
        1
    ):
        address = listing.get(
            "formattedAddress",
            "Unknown"
        )

        print(
            f"    [{index:03d}/{total:03d}] "
            f"{address}"
        )

        result = analyze_listing(
            session,
            listing,
            avm_cache,
            rent_cache,
            property_cache
        )

        if result is not None:
            opportunities.append(
                result
            )

        time.sleep(
            0.05
        )

    return opportunities


def filter_opportunities(
    opportunities: List[Dict[str, Any]]
) -> List[Dict[str, Any]]:
    filtered = []

    for opportunity in opportunities:
        asking_price = opportunity[
            "asking_price"
        ]

        estimated_value = opportunity[
            "estimated_value"
        ]

        net_margin = opportunity[
            "net_investment_margin"
        ]

        if asking_price <= 0:
            continue

        if estimated_value <= 0:
            continue

        if net_margin <= 0:
            continue

        filtered.append(
            opportunity
        )

    filtered.sort(
        key=lambda item: (
            item["opportunity_score"],
            item["net_investment_margin"]
        ),
        reverse=True
    )

    return filtered



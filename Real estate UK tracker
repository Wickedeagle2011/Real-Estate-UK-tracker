def create_session(api_key: str) -> requests.Session:
    session = requests.Session()

    session.headers.update({
        "Accept": "application/json",
        "X-Api-Key": api_key
    })

    return session


def api_get(
    session: requests.Session,
    endpoint: str,
    params: Optional[Dict[str, Any]] = None
) -> Any:
    url = f"{BASE_URL}{endpoint}"

    response = session.get(
        url,
        params=params,
        timeout=REQUEST_TIMEOUT
    )

    if response.status_code == 401:
        raise RuntimeError(
            "RentCast API authentication failed. "
            "Check your API key."
        )

    if response.status_code == 403:
        raise RuntimeError(
            "RentCast API request was forbidden. "
            "Check your API plan and endpoint access."
        )

    if response.status_code == 429:
        raise RuntimeError(
            "RentCast API rate limit reached. "
            "Reduce the number of requests or wait before retrying."
        )

    if not response.ok:
        try:
            details = response.json()
        except Exception:
            details = response.text

        raise RuntimeError(
            f"RentCast API error {response.status_code}: {details}"
        )

    try:
        return response.json()
    except ValueError:
        raise RuntimeError(
            "RentCast returned an invalid JSON response."
        )


def validate_zip_code(zip_code: str) -> str:
    zip_code = str(zip_code).strip()

    if len(zip_code) != 5 or not zip_code.isdigit():
        raise ValueError(
            "ZIP code must be exactly 5 digits."
        )

    return zip_code


def fetch_market_data(
    session: requests.Session,
    zip_code: str,
    history_months: int = DEFAULT_HISTORY_MONTHS
) -> Dict[str, Any]:
    zip_code = validate_zip_code(zip_code)

    params = {
        "zipCode": zip_code,
        "dataType": "All",
        "historyRange": history_months
    }

    return api_get(
        session,
        "/markets",
        params
    )


def extract_history_series(
    market_data: Dict[str, Any]
) -> Dict[str, List[Any]]:
    sale_data = market_data.get(
        "saleData",
        {}
    )

    rental_data = market_data.get(
        "rentalData",
        {}
    )

    sale_history = sale_data.get(
        "history",
        {}
    )

    rental_history = rental_data.get(
        "history",
        {}
    )

    sale_series = []
    rental_series = []

    if isinstance(sale_history, dict):
        for month, values in sorted(
            sale_history.items()
        ):
            if not isinstance(values, dict):
                continue

            price = values.get("averagePrice")

            if price is not None:
                try:
                    sale_series.append({
                        "month": month,
                        "value": float(price)
                    })
                except (ValueError, TypeError):
                    pass

    if isinstance(rental_history, dict):
        for month, values in sorted(
            rental_history.items()
        ):
            if not isinstance(values, dict):
                continue

            rent = values.get("averageRent")

            if rent is not None:
                try:
                    rental_series.append({
                        "month": month,
                        "value": float(rent)
                    })
                except (ValueError, TypeError):
                    pass

    return {
        "sale": sale_series,
        "rental": rental_series
    }


def calculate_percentage_change(
    values: List[float]
) -> float:
    if len(values) < 2:
        return 0.0

    starting_value = values[0]
    ending_value = values[-1]

    if starting_value == 0:
        return 0.0

    return (
        (ending_value - starting_value)
        / abs(starting_value)
    ) * 100.0


def calculate_acceleration(
    values: List[float]
) -> float:
    if len(values) < 3:
        return 0.0

    array = np.array(
        values,
        dtype=float
    )

    time_steps = np.arange(
        len(array),
        dtype=float
    )

    velocity = np.gradient(
        array,
        time_steps
    )

    acceleration = np.gradient(
        velocity,
        time_steps
    )

    return float(
        acceleration[-1]
    )


def calculate_market_metrics(
    market_data: Dict[str, Any]
) -> Dict[str, Any]:
    series = extract_history_series(
        market_data
    )

    sale_series = series["sale"]
    rental_series = series["rental"]

    sale_values = [
        item["value"]
        for item in sale_series
    ]

    rental_values = [
        item["value"]
        for item in rental_series
    ]

    current_sale_price = None
    current_rent = None

    if sale_values:
        current_sale_price = sale_values[-1]

    if rental_values:
        current_rent = rental_values[-1]

    sale_growth = calculate_percentage_change(
        sale_values
    )

    rental_growth = calculate_percentage_change(
        rental_values
    )

    price_acceleration = calculate_acceleration(
        sale_values
    )

    rental_acceleration = calculate_acceleration(
        rental_values
    )

    return {
        "sale_history": sale_series,
        "rental_history": rental_series,
        "current_sale_price": current_sale_price,
        "current_rent": current_rent,
        "sale_growth_percent": sale_growth,
        "rental_growth_percent": rental_growth,
        "price_acceleration": price_acceleration,
        "rental_acceleration": rental_acceleration,
        "history_points_sale": len(sale_values),
        "history_points_rental": len(rental_values)
    }


def calculate_market_score(
    metrics: Dict[str, Any]
) -> float:
    score = 50.0

    sale_growth = metrics.get(
        "sale_growth_percent",
        0.0
    )

    rental_growth = metrics.get(
        "rental_growth_percent",
        0.0
    )

    price_acceleration = metrics.get(
        "price_acceleration",
        0.0
    )

    rental_acceleration = metrics.get(
        "rental_acceleration",
        0.0
    )

    if sale_growth > 0:
        score += min(
            sale_growth * 2.0,
            15.0
        )
    else:
        score += max(
            sale_growth * 1.0,
            -15.0
        )

    if rental_growth > 0:
        score += min(
            rental_growth * 1.5,
            12.0
        )
    else:
        score += max(
            rental_growth * 0.75,
            -12.0
        )

    if price_acceleration > 0:
        score += 8.0

    if rental_acceleration > 0:
        score += 5.0

    return max(
        0.0,
        min(
            score,
            100.0
        )
    )


def fetch_sale_listings(
    session: requests.Session,
    zip_code: str,
    max_listings: int = DEFAULT_MAX_LISTINGS
) -> List[Dict[str, Any]]:
    zip_code = validate_zip_code(zip_code)

    listings = []
    offset = 0

    while len(listings) < max_listings:
        remaining = max_listings - len(listings)

        limit = min(
            DEFAULT_LISTING_LIMIT,
            remaining
        )

        params = {
            "zipCode": zip_code,
            "status": "Active",
            "propertyType": "Single Family",
            "limit": limit,
            "offset": offset
        }

        data = api_get(
            session,
            "/listings/sale",
            params
        )

        if not isinstance(data, list):
            break

        if not data:
            break

        listings.extend(data)

        if len(data) < limit:
            break

        offset += len(data)

        if offset >= max_listings:
            break

    return listings[:max_listings]


def extract_numeric(
    value: Any,
    default: float = 0.0
) -> float:
    try:
        if value is None:
            return default

        number = float(value)

        if not math.isfinite(number):
            return default

        return number

    except (ValueError, TypeError):
        return default


def build_property_text(
    listing: Dict[str, Any],
    property_data: Optional[Dict[str, Any]]
) -> str:
    parts = []

    for key in [
        "listingType",
        "propertyType",
        "formattedAddress"
    ]:
        value = listing.get(key)

        if value:
            parts.append(
                str(value)
            )

    if property_data:
        features = property_data.get(
            "features",
            {}
        )

        if isinstance(features, dict):
            for value in features.values():
                if isinstance(value, str):
                    parts.append(value)

    history = listing.get(
        "history",
        {}
    )

    if isinstance(history, dict):
        for value in history.values():
            if isinstance(value, dict):
                event = value.get("event")

                if event:
                    parts.append(
                        str(event)
                    )

    return " ".join(
        parts
    ).lower()


def detect_repair_risks(
    listing: Dict[str, Any],
    property_data: Optional[Dict[str, Any]]
) -> Dict[str, Any]:
    text = build_property_text(
        listing,
        property_data
    )

    detected = {}
    total_rate = 0.0

    for keyword, cost_per_sqft in REPAIR_COSTS_PER_SQFT.items():
        if keyword in text:
            detected[keyword] = cost_per_sqft
            total_rate += cost_per_sqft

    sqft = extract_numeric(
        listing.get("squareFootage")
    )

    estimated_repair_cost = (
        sqft * total_rate
    )

    return {
        "detected_keywords": list(
            detected.keys()
        ),
        "repair_rate_per_sqft": total_rate,
        "estimated_repair_cost": estimated_repair_cost
    }


def fetch_property_record(
    session: requests.Session,
    address: str
) -> Optional[Dict[str, Any]]:
    if not address:
        return None

    params = {
        "address": address
    }

    try:
        data = api_get(
            session,
            "/properties",
            params
        )

        if isinstance(data, list):
            if data:
                return data[0]

            return None

        if isinstance(data, dict):
            return data

        return None

    except Exception:
        return None


def fetch_avm_value(
    session: requests.Session,
    address: str,
    cache: Dict[str, Dict[str, Any]]
) -> Optional[Dict[str, Any]]:
    if not address:
        return None

    if address in cache:
        return cache[address]

    params = {
        "address": address
    }

    try:
        data = api_get(
            session,
            "/avm/value",
            params
        )

        if isinstance(data, dict):
            cache[address] = data
            return data

    except Exception:
        return None

    return None


def calculate_price_discount(
    asking_price: float,
    estimated_value: float
) -> float:
    if asking_price <= 0:
        return 0.0

    return (
        (
            estimated_value
            - asking_price
        )
        / asking_price
    ) * 100.0


def calculate_rental_yield(
    monthly_rent: Optional[float],
    purchase_price: float
) -> float:
    if (
        monthly_rent is None
        or monthly_rent <= 0
        or purchase_price <= 0
    ):
        return 0.0

    return (
        monthly_rent * 12
        / purchase_price
    ) * 100.0


def estimate_monthly_rent(
    session: requests.Session,
    address: str,
    cache: Dict[str, Dict[str, Any]]
) -> Optional[float]:
    if not address:
        return None

    if address in cache:
        data = cache[address]
    else:
        params = {
            "address": address
        }

        try:
            data = api_get(
                session,
                "/avm/rent/long-term",
                params
            )

            if not isinstance(data, dict):
                return None

            cache[address] = data

        except Exception:
            return None

    rent = extract_numeric(
        data.get("rent"),
        0.0
    )

    if rent <= 0:
        return None

    return rent


def calculate_investment_margin(
    estimated_value: float,
    asking_price: float,
    repair_cost: float
) -> float:
    return (
        estimated_value
        - asking_price
        - repair_cost
    )


def calculate_opportunity_score(
    discount_percent: float,
    net_margin: float,
    rental_yield: float,
    days_on_market: float,
    listing_type: str,
    repair_cost: float,
    estimated_value: float
) -> float:
    score = 0.0

    if discount_percent > 0:
        score += min(
            discount_percent * 2.5,
            40.0
        )

    if net_margin > 0 and estimated_value > 0:
        margin_percent = (
            net_margin
            / estimated_value
        ) * 100.0

        score += min(
            margin_percent * 1.5,
            30.0
        )

    if rental_yield > 0:
        score += min(
            rental_yield * 2.0,
            15.0
        )

    if days_on_market > 60:
        score += 5.0

    if listing_type in [
        "Foreclosure",
        "Short Sale"
    ]:
        score += 5.0

    if repair_cost > 0:
        repair_ratio = (
            repair_cost
            / max(
                estimated_value,
                1.0
            )
        ) * 100.0

        score -= min(
            repair_ratio,
            15.0
        )

    return max(
        0.0,
        min(
            score,
            100.0
        )
    )


def analyze_listing(
    session: requests.Session,
    listing: Dict[str, Any],
    avm_cache: Dict[str, Dict[str, Any]],
    rent_cache: Dict[str, Dict[str, Any]],
    property_cache: Dict[str, Optional[Dict[str, Any]]]
) -> Optional[Dict[str, Any]]:
    address = listing.get(
        "formattedAddress",
        ""
    )

    price = extract_numeric(
        listing.get("price")
    )

    bedrooms = extract_numeric(
        listing.get("bedrooms")
    )

    bathrooms = extract_numeric(
        listing.get("bathrooms")
    )

    sqft = extract_numeric(
        listing.get("squareFootage")
    )

    days_on_market = extract_numeric(
        listing.get("daysOnMarket")
    )

    listing_type = str(
        listing.get(
            "listingType",
            "Standard"
        )
    )

    if not address:
        return None

    if price <= 0:
        return None

    if sqft <= 0:
        return None

    if address not in property_cache:
        property_cache[address] = fetch_property_record(
            session,
            address
        )

    property_data = property_cache[address]

    avm = fetch_avm_value(
        session,
        address,
        avm_cache
    )

    if not avm:
        return None

    estimated_value = extract_numeric(
        avm.get("price")
    )

    value_low = extract_numeric(
        avm.get("priceRangeLow")
    )

    value_high = extract_numeric(
        avm.get("priceRangeHigh")
    )

    if estimated_value <= 0:
        return None

    rental_estimate = estimate_monthly_rent(
        session,
        address,
        rent_cache
    )

    repair_data = detect_repair_risks(
        listing,
        property_data
    )

    repair_cost = repair_data[
        "estimated_repair_cost"
    ]

    net_margin = calculate_investment_margin(
        estimated_value,
        price,
        repair_cost
    )

    discount_percent = calculate_price_discount(
        price,
        estimated_value
    )

    rental_yield = calculate_rental_yield(
        rental_estimate,
        price
    )

    opportunity_score = calculate_opportunity_score(
        discount_percent,
        net_margin,
        rental_yield,
        days_on_market,
        listing_type,
        repair_cost,
        estimated_value
    )

    return {
        "address": address,
        "city": listing.get("city", ""),
        "state": listing.get("state", ""),
        "zip_code": listing.get("zipCode", ""),
        "property_type": listing.get(
            "propertyType",
            ""
        ),
        "bedrooms": bedrooms,
        "bathrooms": bathrooms,
        "square_footage": sqft,
        "year_built": listing.get(
            "yearBuilt"
        ),
        "asking_price": price,
        "estimated_value": estimated_value,
        "value_range_low": value_low,
        "value_range_high": value_high,
        "discount_percent": discount_percent,
        "estimated_repair_cost": repair_cost,
        "net_investment_margin": net_margin,
        "monthly_rent_estimate": rental_estimate,
        "gross_rental_yield": rental_yield,
        "days_on_market": days_on_market,
        "listing_type": listing_type,
        "repair_signals": repair_data[
            "detected_keywords"
        ],
        "opportunity_score": opportunity_score,
        "avm_comparable_count": len(
            avm.get(
                "comparables",
                []
            )
        ),
        "listing_id": listing.get(
            "id",
            ""
        )
    }


def analyze_market(
    session: requests.Session,
    zip_code: str,
    history_months: int
) -> Dict[str, Any]:
    print(
        "\n[1/5] Downloading market history..."
    )

    market_data = fetch_market_data(
        session,
        zip_code,
        history_months
    )

    metrics = calculate_market_metrics(
        market_data
    )

    metrics["market_score"] = calculate_market_score(
        metrics
    )

    return metrics



        print(
            f"    AVM Comparables    : "
            f"{deal['avm_comparable_count']}"
        )

        print("-" * 100)


def format_currency_or_na(
    value: Optional[float]
) -> str:
    if value is None:
        return "N/A"

    return f"${value:,.0f}"


def export_csv(
    opportunities: List[Dict[str, Any]],
    filename: str
) -> None:
    if not opportunities:
        return

    fields = [
        "rank",
        "address",
        "city",
        "state",
        "zip_code",
        "property_type",
        "bedrooms",
        "bathrooms",
        "square_footage",
        "year_built",
        "asking_price",
        "estimated_value",
        "value_range_low",
        "value_range_high",
        "discount_percent",
        "estimated_repair_cost",
        "net_investment_margin",
        "monthly_rent_estimate",
        "gross_rental_yield",
        "days_on_market",
        "listing_type",
        "repair_signals",
        "opportunity_score",
        "avm_comparable_count",
        "listing_id"
    ]

    with open(
        filename,
        "w",
        newline="",
        encoding="utf-8"
    ) as file:
        writer = csv.DictWriter(
            file,
            fieldnames=fields
        )

        writer.writeheader()

        for rank, opportunity in enumerate(
            opportunities,
            1
        ):
            row = dict(
                opportunity
            )

            row["rank"] = rank

            row["repair_signals"] = ", ".join(
                opportunity.get(
                    "repair_signals",
                    []
                )
            )

            writer.writerow(
                {
                    field: row.get(
                        field,
                        ""
                    )
                    for field in fields
                }
            )


def get_api_key() -> str:
    api_key = os.getenv(
        "RENTCAST_API_KEY",
        ""
    ).strip()

    if api_key:
        return api_key

    print(
        "\nRentCast API key not found in environment."
    )

    api_key = input(
        "Enter your RentCast API key: "
    ).strip()

    if not api_key:
        raise ValueError(
            "An API key is required."
        )

    return api_key


def get_zip_code() -> str:
    while True:
        zip_code = input(
            "\nEnter the US ZIP code to analyse: "
        ).strip()

        try:
            return validate_zip_code(
                zip_code
            )
        except ValueError as e:
            print(
                f"[-] {e}"
            )


def get_integer(
    prompt: str,
    default: int,
    minimum: int,
    maximum: int
) -> int:
    while True:
        raw = input(
            f"{prompt} [{default}]: "
        ).strip()

        if not raw:
            return default

        try:
            value = int(raw)

            if minimum <= value <= maximum:
                return value

            print(
                f"Enter a number between "
                f"{minimum} and {maximum}."
            )

        except ValueError:
            print(
                "Enter a valid whole number."
            )


